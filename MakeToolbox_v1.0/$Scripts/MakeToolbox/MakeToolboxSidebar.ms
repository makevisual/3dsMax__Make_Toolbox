global MT_headderCheatBM = bitmap 170 100 color:(color 68 68 68)
)

-- read the ini file
(
global MakeToolbox
global MakeToolboxSettingsINI = "$Scripts\MakeToolbox\MakeToolboxSettings.ini"
global modulesDirectory = getIniSetting MakeToolboxSettingsINI "Modules Directory" "modulesDirectory"
global runningManDirectory = getIniSetting MakeToolboxSettingsINI "Running Man Directory" "runningManDirectory"
)	

	
-- create icons and prepare buttons
(
fn strToBit str =
	(
		bitArr = execute str
		bit1 = bitmap bitArr[1].count bitArr.Count
		for q in 0 to bitArr.count - 1 do
		(setpixels bit1 [0, q] bitArr[q + 1])
		bit1
	)
global MT_bitmap_tabsColor = strToBit MT_string_tabsColor
global MT_bitmap_tabsAlpha = strToBit MT_string_tabsAlpha
global MT_bitmap_tab_01 = strToBit MT_string_tab_01
global MT_bitmap_tab_02 = strToBit MT_string_tab_02
global MT_bitmap_tab_03 = strToBit MT_string_tab_03
global MT_bitmap_tab_04 = strToBit MT_string_tab_04
global MT_bitmap_tab_05 = strToBit MT_string_tab_05
global MT_bitmap_tab_06 = strToBit MT_string_tab_06
global MT_btn_width = 29
	
global lab1String = ("Make Toolbox v" + (MakeToolboxVer as string))
)

-- initalize the dynamic module sets
(
global addModuleToMemory = true
global commonTabExtraModules = #()
global modelingTabExtraModules = #()
global riggingTabExtraModules = #()
global layoutTabExtraModules = #()
global renderTabExtraModules = #()
global MT_CurrentTabExtraModule = commonTabExtraModules
)

-- Destroy the toobox if it exists already
try(cui.UnRegisterDialogBar MakeToolbox)catch()
try(destroyDialog MakeToolbox)catch()

function getMyRollouts = 
	(
	print MakeToolbox.theSubrollout.rollouts
	print MakeToolbox.theSubrollout.rollouts.count
	)
	
function removeMyRollouts =
	(
	for i in 1 to MakeToolbox.theSubrollout.rollouts.count do
		(
		removeSubRollout MakeToolbox.theSubrollout MakeToolbox.theSubrollout.rollouts[MakeToolbox.theSubrollout.rollouts.count]
		)
	)

function addCurrentTabExtraModulesFunction = 
	(
	try
		(
		for i in 1 to MT_CurrentTabExtraModule.count do
			(
			filein MT_CurrentTabExtraModule[i]
			)
		)catch()
	)
		
--Function for the information floater's CHANGE LOG
function formatInformationTextBox informationTextBox=
	(
		informationTextBox.multiline = true
 		informationTextBox.wordwrap = true
		informationTextBox.ReadOnly = true
		informationTextBox.BackColor = (dotNetClass "System.Drawing.Color").FromArgb 68 68 68
		informationTextBox.ForeColor = (dotNetClass "System.Drawing.Color").FromArgb 200 200 200

------------------------------------------------------------------------------
------------------- THIS IS THE CHANGE LOG -------------------------
------------------------------------------------------------------------------

		informationTextBox.text = "
* Build V1.1 Update - 6/6/2012
Updated the MT_autobak to not save a file during animation playback.

-Aaron Dabelow
		
		
* Build V1.0 Update - 3/29/2012
Added links to the Video Help, and Minor bug fixes.
http://www.makevisual.com/learning/

-Aaron Dabelow

		
* Initial Build V1.0 - 3/27/2012
This is the first build of the software, code contributed by Aaron Dabelow, Tyson Ibele, and Romain Faure, for MAKE.

If there are any issues to report with this script package, please contact me at aarond@makevisual.com and include as much information as possible regarding the error.

-Aaron Dabelow
"
	)

--Function for the information floater's HELP FILE
function formatHelpTextBox helpTextBox=
	(
		helpTextBox.multiline = true
 		helpTextBox.wordwrap = true
		helpTextBox.ReadOnly = true
		helpTextBox.DetectUrls = true
		helpTextBox.BackColor = (dotNetClass "System.Drawing.Color").FromArgb 68 68 68
		helpTextBox.ForeColor = (dotNetClass "System.Drawing.Color").FromArgb 200 200 200

------------------------------------------------------------------------------
-------------------- THIS IS THE HELP FILE ---------------------------
------------------------------------------------------------------------------

		helpTextBox.text = "
* MAKE Toolbox help
Access the Video Help here: http://www.makevisual.com/learning/
Watch the introduction video here: www.makevisual.com/learning/makeToolbox_introduction.htm
		
The Make toolbox is a collection of tools created at MAKE for use of its 3D artists. It contains preset tabs with tool modules in each of the tabs. These tabs are 'General', 'Modeling', 'Rigging', 'Animation', 'Rendering', and 'Custom'. The custom tab allows users to make as many custom layouts as they would like.
		
The way the toolbox works is it is a sidebar with small tool packages loaded into it called 'modules' these modules contain tools of similar or related tasks. The toolbox can also run scripts that were not built as part of the toolbox, but are launched from a seperate directory. 
"
	)
	
-- Rollout floater for the information dialog
rollout MakeToolboxInformation "Make Toolbox Information" width:350 height:342
	(
	label lab1 "Make Toolbox Information" align:#center offset:[0,5]
	label lab2 "Help:" align:#left offset:[0,5]
	dotnetcontrol helpTextBox "System.Windows.Forms.RichTextBox" width:325 height:120 align:#left
	label lab3 "Change Log:" align:#left offset:[0,5]
	dotnetcontrol informationTextBox "System.Windows.Forms.RichTextBox" width:325 height:120 align:#left
	hyperlink theHyperlink "www.makevisual.com" visitedColor:white address:"www.makevisual.com"
		
-- executes our function to edit the textbox
	on MakeToolboxInformation open do
		(
		formatInformationTextBox informationTextBox
		formatHelpTextBox helpTextBox
		)
		
	on helpTextBox LinkClicked sender args do
		(
		shelllaunch args.LinkText ""
		)
	)
	
-- Rollout for the Main Sidebar
rollout MakeToolbox ("Make Toolbox v" + (MakeToolboxVer as string))
(
checkbutton headderbutton1 "C" height:MT_btn_width width:MT_btn_width  pos:[0,0] checked:true border:true images:#(MT_bitmap_tab_01, MT_bitmap_tabsAlpha, 4, 2, 1, 3, 4) tooltip:"Common Tools"
checkbutton headderbutton2 "M" height:MT_btn_width width:MT_btn_width pos:[MT_btn_width,0] checked:false  border:true images:#(MT_bitmap_tab_02, MT_bitmap_tabsAlpha, 4, 2, 1, 3, 4)  tooltip:"Modeling Tools"
checkbutton headderbutton3 "Ri" height:MT_btn_width width:MT_btn_width pos:[(MT_btn_width*2),0] checked:false  border:true images:#(MT_bitmap_tab_03, MT_bitmap_tabsAlpha, 4, 2, 1, 3, 4) tooltip:"Rigging tools"
checkbutton headderbutton4 "L" height:MT_btn_width width:MT_btn_width pos:[(MT_btn_width*3),0] checked:false  border:true images:#(MT_bitmap_tab_04, MT_bitmap_tabsAlpha, 4, 2, 1, 3, 4) tooltip:"Animation Tools"
checkbutton headderbutton5 "Rn" height:MT_btn_width width:MT_btn_width pos:[(MT_btn_width*4),0] checked:false  border:true images:#(MT_bitmap_tab_05, MT_bitmap_tabsAlpha,4, 2, 1, 3, 4) tooltip:"Rendering Tools"
checkbutton headderbutton6 "!" height:MT_btn_width width:MT_btn_width pos:[(MT_btn_width*5),0] checked:false  border:true images:#(MT_bitmap_tab_06, MT_bitmap_tabsAlpha, 4, 2, 1, 3, 4) tooltip:"Custom Presets" 

SubRollout theSubrollout "Subrollout" height:940 width:178 pos:[-2,28]	
imgtag MT_headderCheat width:180 height:2 bitmap:MT_headderCheatBM pos:[-2,27] tooltip: "Rig Nodes and Control Splines"
timer clock "testClock" interval:500 --tick every 5 seconds
	
button headderSettingsButton "Settings" height:20 align:#left width:55 tooltip:"allows you to se the directories that the toolbox is reading from"--pos:[75,0]
button headderLauncherButton "Run" height:20 width:40 pos:[3,0] tooltip:"Runs the script launcher"
button addModuleButton "+" height:20 width:20 pos:[90,0] tooltip:"adds a module to the toolbox"
button clearModulesButton "-" height:20 width:20 pos:[110,0] tooltip:"removes all the modules from the toolbox"
button headderInfoButton "?"  height:20 width:20 pos:[120,0] tooltip:"gives information and help about the toolbox and modules"
button headderDetachButton ">" height:20 width:20 pos:[150,0] tooltip:"detaches the toobox"
button headderAttachButton "<" height:20 width:20 pos:[150,0] visible:false tooltip:"attaches the toolbox"

function checkHeadderButtons =
(
headderbutton1.checked = false
headderbutton2.checked = false
headderbutton3.checked = false
headderbutton4.checked = false
headderbutton5.checked = false
headderbutton6.checked = false
)	

------------------------------------------------------------------------------
--------------------- DEFINE TAB PRESETS  ----------------------------
------------------------------------------------------------------------------

-- COMMON TOOLS PRESETS --
on headderbutton1 changed state do
	(
	checkHeadderButtons()
	headderbutton1.checked = True
	removeMyRollouts()
	MT_CurrentTabExtraModule = commonTabExtraModules
	try(filein "$Scripts\MakeToolbox\modules\MT_LayoutTools.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_MaterialsAndWires.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ModifierGlobals.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_Lock_Transforms.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_MirrorRig.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_EditPivots.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ColorsThinger.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_SceneUtilities.ms") catch(messagebox "File not in modules directory!")
	addCurrentTabExtraModulesFunction()
	)

-- MODELING TOOLS PRESETS --
on headderbutton2 changed state do
	(
	checkHeadderButtons()
	headderbutton2.checked = True
	removeMyRollouts()
	MT_CurrentTabExtraModule = modelingTabExtraModules
	try(filein "$Scripts\MakeToolbox\modules\MT_MaterialsAndWires.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_MirrorRig.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_EditPivots.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_Cluster_attach.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ObjectConformer.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_AlignAnCopy.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_RemoveWingedVerts.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_DebrisMaker.ms") catch(messagebox "File not in modules directory!")
	
	addCurrentTabExtraModulesFunction()
	)
	
-- RIGGING TOOLS PRESETS --
on headderbutton3 changed state do
	(
	checkHeadderButtons()
	headderbutton3.checked = True
	removeMyRollouts()
	MT_CurrentTabExtraModule = riggingTabExtraModules
	try(filein "$Scripts\MakeToolbox\modules\MT_EditPivots.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_MirrorRig.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_guiObjects.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_Lock_Transforms.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_RivetMaker.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ColorsThinger.ms") catch(messagebox "File not in modules directory!")
	addCurrentTabExtraModulesFunction()
	)
	
-- ANIMATION TOOLS PRESETS --
on headderbutton4 changed state do
	(
	checkHeadderButtons()
	headderbutton4.checked = True
	removeMyRollouts()
	MT_CurrentTabExtraModule = layoutTabExtraModules
	try(filein "$Scripts\MakeToolbox\modules\MT_ControllerCollapse.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_TransformsBaker.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_Camera_Shaker.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_DebrisMaker.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ParticleConnector.ms") catch(messagebox "File not in modules directory!")
	addCurrentTabExtraModulesFunction()
	)
	
-- RENDER TOOLS PRESETS --
on headderbutton5 changed state do
	(
	checkHeadderButtons()
	headderbutton5.checked = True
	removeMyRollouts()
	MT_CurrentTabExtraModule = renderTabExtraModules
	try(filein "$Scripts\MakeToolbox\modules\MT_MaterialsAndWires.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_Isolate_A_Light.ms") catch(messagebox "File not in modules directory!")
	--try(filein "$Scripts\MakeToolbox\modules\MT_TextureResizer.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ModifierGlobals.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ColorsThinger.ms") catch(messagebox "File not in modules directory!")
	addCurrentTabExtraModulesFunction()
	)
	
-- CUSTOM TOOLS PRESETS --
on headderbutton6 changed state do
	(
	checkHeadderButtons()
	headderbutton6.checked = True
	removeMyRollouts()
	currentModulesArray = #()
	filein "$Scripts\MakeToolbox\MakeToolboxPresets.ms"
	)
	
on headderLauncherButton pressed do
	(
	try
		(
		global scriptmanager_open
		addModuleToMemory = false
		filein "$Scripts\MakeToolbox\MakeToolboxScriptmanager.ms"
		scriptManager_open (runningManDirectory + "\\") buttonText:"Run Script" titleText:"Choose script to run"
		)catch(messagebox "error launching scriptmanager")
	)
	
on addModuleButton pressed do
	(
	try
		(
		global scriptmanager_open
		addModuleToMemory = true
		filein "$Scripts\MakeToolbox\MakeToolboxScriptmanager.ms"
		scriptManager_open (modulesDirectory + "\\") buttonText:"Add Module" titleText:"Choose module to add"
		)catch(messagebox "error launching scriptmanager")
	)
on clearModulesButton pressed do
	(
	if querybox "This will remove all the modules from the sidebar, are you sure you wish to continue?" then
		(
		removeMyRollouts()
		MT_CurrentTabExtraModule = #()
		)
	)
on destroyButton pressed do
	(
	try(cui.UnRegisterDialogBar MakeToolbox)catch()
	try(destroyDialog MakeToolbox)catch()
	)
	on headderDetachButton pressed do
	(
try(cui.UnRegisterDialogBar MakeToolbox)catch()
	headderDetachButton.visible = false
	headderAttachButton.visible = true
	)
on headderAttachButton pressed do
	(
	MakeToolbox.height	= 970
	try(cui.registerdialogbar MakeToolbox style:#(#cui_dock_left,#cui_floatable);cui.dockdialogbar MakeToolbox #cui_dock_left)catch()
	headderDetachButton.visible = true
	headderAttachButton.visible = false
	)
on headderSettingsButton pressed do(try(filein "$Scripts\MakeToolbox\MakeToolboxSettingsEdit.ms") catch(messagebox "Error loading script"))
on headderInfoButton pressed do(try(destroyDialog MakeToolboxInformation)catch();createDialog MakeToolboxInformation)
on MakeToolbox resized arg do
	(
	theSubrollout.height = (MakeToolbox.height - 50)
	headderSettingsButton.pos = [0,(MakeToolbox.height - 20)]
	headderLauncherButton.pos = [55,(MakeToolbox.height - 20)]
	addModuleButton.pos = [95,(MakeToolbox.height - 20)]
	clearModulesButton.pos = [115,(MakeToolbox.height - 20)]
	headderInfoButton.pos = [135,(MakeToolbox.height - 20)]
	headderDetachButton.pos = [155,(MakeToolbox.height - 20)]
	headderAttachButton.pos = [155,(MakeToolbox.height - 20)]
	) 
)

disablesceneredraw()
createDialog MakeToolbox 175 970 style:#(#style_titlebar, #style_border, #style_sysmenu,#style_resizing) lockWidth:true
	try(filein "$Scripts\MakeToolbox\modules\MT_LayoutTools.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_MaterialsAndWires.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ModifierGlobals.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_Lock_Transforms.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_MirrorRig.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_EditPivots.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_ColorsThinger.ms") catch(messagebox "File not in modules directory!")
	try(filein "$Scripts\MakeToolbox\modules\MT_SceneUtilities.ms") catch(messagebox "File not in modules directory!")
cui.registerdialogbar MakeToolbox style:#(#cui_dock_left,#cui_floatable)
cui.dockdialogbar MakeToolbox #cui_dock_left
enablesceneredraw()
redrawviews()
